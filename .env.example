# Environment variables configuration

# Development mode
NODE_ENV=development

# Debug mode (set to 'true' for verbose logging)
DEBUG=false

# API Configuration
API_TIMEOUT=30000

# OCR Configuration
OCR_LANGUAGE=eng
OCR_TESSDATA_PREFIX=./tessdata

# Export Configuration
EXPORT_QUALITY=high
EXPORT_DEFAULT_FORMAT=pdf

# Audio Configuration
AUDIO_SAMPLE_RATE=44100
AUDIO_CHANNELS=1
AUDIO_ENCODING=mp3

# Image Configuration
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_COMPRESSION_LEVEL=9

# Application Configuration
APP_TITLE=Screen Capture App
APP_VERSION=1.0.0
WINDOW_WIDTH=1200
WINDOW_HEIGHT=800

# Paths
TEMP_DIR=./temp
LOGS_DIR=./logs
OUTPUT_DIR=./output